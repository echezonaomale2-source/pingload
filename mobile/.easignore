# When .easignore exists, EAS ignores .gitignore — keep both in sync.
# See: https://expo.fyi/eas-build-archive

node_modules/
.expo/
.expo-*/
dist/
.env
*.log
.DS_Store

# Continuous Native Generation — native projects are generated by EAS/prebuild
/android
/ios

# Local build artifacts (must not upload)
releases/
releases/**
build-apk-info.json
*.apk
*.aab
eas-build*.log
build-view.json
bv*.json

# Local tooling / secrets
.tools/
android/local.properties
android/keystore.properties
android/*.keystore
android/app/*.keystore
scripts/build-android-release.ps1
